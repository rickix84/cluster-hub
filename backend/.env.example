# Cluster Hub Backend - Environment Variables
# Copy this file to .env and fill in the values

# JWT Secret for token signing/verification (use a strong random string)
CLUSTER_HUB_JWT_SECRET=your-secret-here

# LocalAI base URL (the upstream LLM service; omit /v1 because routes add it)
LOCALAI_BASE_URL=https://localai.tail6518ad.ts.net

# LocalAI API key (keep in a protected env/SecretRef; never commit a real value)
LOCALAI_API_KEY=

# LocalAI request timeout in milliseconds
LOCALAI_TIMEOUT_MS=30000

# CORS origin (use * for development, restrict in production)
CORS_ORIGIN=*

# Server port (default: 3001)
PORT=3001
